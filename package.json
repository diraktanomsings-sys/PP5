{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k npm:dev:api npm:dev:web",
    "dev:api": "tsx server/dev.ts",
    "dev:web": "vite --port=3000 --host=127.0.0.1",
    "check": "tsc --noEmit -p tsconfig.production.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run check"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": "24.x"
  }
}
